  "homepage": "https://github.com/vsonti23/shipyard#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
