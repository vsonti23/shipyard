  "main": "index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node build/server.js",
    "dev": "tsx watch src/server.ts",
